{
  "name": "elekha",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "expo run:ios",
    "lint": "expo lint",
    "test": "vitest run",
    "test:database": "vitest run tests/databaseIntegrity.test.ts tests/databaseMigrationContract.test.ts tests/appDatabaseStartup.test.ts",
    "test:database:migration": "vitest run tests/databaseMigrationContract.test.ts",
    "test:database:startup": "vitest run tests/appDatabaseStartup.test.ts",
    "test:startup": "vitest run tests/describeDatabaseStartupFailure.test.ts tests/bootstrapStartup.useCase.test.ts tests/startupPresentationState.util.test.ts",
    "check:theme-colors": "node ./scripts/check-no-static-theme-colors.js",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run check:theme-colors && npm test",
    "build:android:production": "eas build --platform android --profile production",
    "submit:android:internal": "eas submit --platform android --profile production --latest",
    "export:mobile": "expo export --platform ios && expo export --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@nozbe/watermelondb": "^0.28.0",
    "@samirkoirala/bs-calendar-react": "^1.1.1",
    "expo": "^57.0.9",
    "expo-build-properties": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.16",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.40.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.5.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ],
        "listUnknownPackages": true
      }
    }
  },
  "private": true
}
